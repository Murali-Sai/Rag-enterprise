# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# (When present, this replaces .gitignore for upload filtering.)

.git
.github
.claude
.venv
__pycache__
*.pyc
.mypy_cache
.pytest_cache
.ruff_cache

# Secrets — never upload
.env
.env.*

# The working index. chroma_dist/ is what ships — it is deliberately NOT
# excluded here, and it is the reason an upload is ~106 MB rather than ~1 MB.
chroma_data/
data/edgar/**/*.html
data/edgar/**/*.json
.cache/
*.db
*.sqlite
audit_logs/

# Not needed in the build
infra/
tests/
evaluation/results/
docker-compose.yml
