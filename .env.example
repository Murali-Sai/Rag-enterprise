# LLM Provider: openai | groq | gemini | huggingface
LLM_PROVIDER=openai
# Runtime generation model for the openai provider.
OPENAI_MODEL=gpt-4o

# API Keys. OPENAI_API_KEY is required by the defaults below (generation and
# embeddings); groq/gemini are free-tier alternatives if you set LLM_PROVIDER
# and EMBEDDING_PROVIDER away from openai.
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Embeddings: openai | huggingface
#
# openai      text-embedding-3-small — 1536-dim, 8k-token input window.
# huggingface all-MiniLM-L6-v2 — 384-dim, and truncates at 256 tokens
#             (~1300 chars of filing prose); anything past that is dropped at
#             embedding time and cannot be retrieved. No API key, no network.
#
# The two produce different-sized vectors, so switching provider means
# rebuilding the Chroma collection — an existing index cannot be queried with
# the other provider's embeddings.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Store: chroma | opensearch
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_data
# Collection name — point at an alternate index (e.g. one built by
# scripts/build_semantic_index.py) to A/B a different chunking strategy.
CHROMA_COLLECTION=rag_enterprise

# Chunking: fixed | recursive | semantic
#
# fixed      character windows with overlap, structure-blind. The baseline.
# recursive  splits on paragraph/line/sentence boundaries before characters.
# semantic   splits where consecutive sentence embeddings diverge.
#
# Only affects new ingestion — an existing index keeps the chunks it was built
# with, so comparing strategies means one CHROMA_COLLECTION per strategy.
# Every chunk records the strategy that produced it.
CHUNKING_STRATEGY=recursive

# Floor on chunk length, applied after splitting. The recursive splitter cannot
# merge a short line into a neighbour already near the budget, so a bare
# heading or a leftover page marker becomes a chunk of its own and then
# competes for a top_k slot with real paragraphs. Below 80 characters the
# corpus is headings ("Competition"), document furniture ("PART II Item 8"),
# and splitter fragments — 618 chunks, none of which can answer anything.
# Don't raise it much: by 200 it deletes real sentences. Set to 0 to disable.
#
# Page headers and footers with a recognisable shape are removed earlier, in
# the parser, so they never reach chunking at all. This is the catch-all.
MIN_CHUNK_CHARS=80

# Near-duplicate suppression at ingestion. A duplicate chunk competes for one
# of the top_k slots at query time and wins it, displacing something the LLM
# would otherwise have seen. 7.8% of the SEC corpus is duplicated at 0.95.
# Keep the threshold high: below ~0.9 it starts discarding chunks that merely
# discuss the same topic, which is a silent recall loss.
DEDUP_ENABLED=true
DEDUP_THRESHOLD=0.95

# Retrieval
RETRIEVAL_TOP_K=5

# HyDE — generate a hypothetical filing passage answering the question and
# embed that instead of the question, so retrieval matches document-to-
# document. Costs one extra LLM call per query before retrieval.
HYDE_ENABLED=false
# Keep the original question alongside the generated passage (pure HyDE
# discards it, which can lose literal terms like tickers or "Item 7A").
HYDE_INCLUDE_QUERY=false

# Hybrid search — pairs dense embedding search with a BM25 lexical index and
# fuses the rankings (RRF). BM25 catches the exact-match terms filings are
# full of (tickers, "Item 7A", dollar figures) that embeddings blur together.
# Off by default: measured -0.23 Context Recall (see README ablation). Set to
# true to experiment with it.
HYBRID_SEARCH_ENABLED=false

# Re-ranking — retrieves RERANK_CANDIDATE_K candidates, reranks with a
# cross-encoder, cuts to RETRIEVAL_TOP_K for the LLM. Set RERANK_ENABLED=false
# to fall back to plain ChromaDB similarity search.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=20

# Citation verification — parse the [n] citations out of an answer, pair each
# cited sentence with the chunk it points at, and ask a judge whether that
# chunk supports it. Off at runtime: it costs one LLM call per citation
# (5-15 per answer) on the critical path. The signals that feed the
# confidence score — citation coverage, invalid references — come from
# parsing alone and are always on. The eval harness forces this on, which is
# where the cost buys the citation_accuracy metric.
CITATION_VERIFICATION_ENABLED=false
CITATION_JUDGE_PROVIDER=openai
CITATION_JUDGE_MODEL=gpt-4o-mini

# Below this retrieval confidence the system returns a structured account of
# what it searched — passages consulted, filings worth reading by hand —
# instead of generating an answer over chunks it does not trust. The scale is
# the normalized relevance in src/retrieval/scores.py: on the default
# reranked pipeline, a logistic over cross-encoder logits, which is strongly
# bimodal, so 0.15 is conservative. Set to 0 to disable the gate.
INSUFFICIENT_CONTEXT_THRESHOLD=0.15

# RAGAS eval judge (openai | gemini | groq) — separate from LLM_PROVIDER so
# switching the app's generation model doesn't change what judges eval scores.
# Stays on gpt-4o-mini while runtime generation is gpt-4o: the judge is
# measurement apparatus, and changing it invalidates comparison with every
# result already in evaluation/results/.
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4o-mini

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./rag_enterprise.db

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT=20/minute

# SEC EDGAR (free, no API key needed — only requires User-Agent)
EDGAR_USER_AGENT=YourName your.email@example.com
EDGAR_DATA_DIR=./data/edgar
