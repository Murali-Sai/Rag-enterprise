# LLM Provider: groq | gemini | huggingface | openai
LLM_PROVIDER=groq

# API Keys (get free keys from respective providers)
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Store: chroma | opensearch
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_data

# Retrieval
RETRIEVAL_TOP_K=5

# Hybrid search — pairs dense embedding search with a BM25 lexical index and
# fuses the rankings (RRF). BM25 catches the exact-match terms filings are
# full of (tickers, "Item 7A", dollar figures) that embeddings blur together.
# Off by default: measured -0.23 Context Recall (see README ablation). Set to
# true to experiment with it.
HYBRID_SEARCH_ENABLED=false

# Re-ranking — retrieves RERANK_CANDIDATE_K candidates, reranks with a
# cross-encoder, cuts to RETRIEVAL_TOP_K for the LLM. Set RERANK_ENABLED=false
# to fall back to plain ChromaDB similarity search.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=20

# RAGAS eval judge (openai | gemini | groq) — separate from LLM_PROVIDER so
# switching the app's generation model doesn't change what judges eval scores.
EVAL_JUDGE_PROVIDER=openai

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./rag_enterprise.db

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT=20/minute

# SEC EDGAR (free, no API key needed — only requires User-Agent)
EDGAR_USER_AGENT=YourName your.email@example.com
EDGAR_DATA_DIR=./data/edgar
